# Copy this file to .env and fill in your own values. Never commit .env.
# Network: Base Mainnet (chain ID 8453). This setup uses real funds.
BASE_NETWORK=mainnet
BASE_RPC_URL=https://mainnet.base.org
# Create the agent wallet yourself (see SKILL.md). Paste the key here. Never share it.
AGENT_WALLET_PRIVATE_KEY=
# o1 Launchpad API key (create at https://launch.o1.exchange/developers?chain=8453). Keep it out of git.
LAUNCHPAD_API_KEY=
# Morpho API key (for morpho-health and Morpho actions). Request: https://docs.morpho.org/request-api-key/
MORPHO_API_KEY=
