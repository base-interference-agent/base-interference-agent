# Copy this file to .env and fill in your own values. Never commit .env.
# Base Sepolia (testnet) is the default. Use mainnet only with small amounts.
BASE_NETWORK=sepolia
BASE_RPC_URL=https://sepolia.base.org
# Create the agent wallet yourself (see SKILL.md). Paste the key here. Never share it.
AGENT_WALLET_PRIVATE_KEY=
